# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.
# Never commit real values.

# Neon: use the POOLED connection string (the host contains "-pooler").
DATABASE_URL=

# Create with:  npm run hash-password -- "your admin password"
ADMIN_PASSWORD_HASH=

# At least 32 random characters. Create with:  openssl rand -base64 48
SESSION_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local: http://localhost:3000   Production: https://your-domain.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enquiry emails through Resend. Leave empty to only save enquiries in the database.
RESEND_API_KEY=
# The inbox that receives enquiries.
ENQUIRY_TO_EMAIL=
# Sender address. Use onboarding@resend.dev while testing, then an address on your verified domain.
ENQUIRY_FROM_EMAIL=onboarding@resend.dev
